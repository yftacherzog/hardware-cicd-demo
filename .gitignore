# 1. Simulator Build Artifacts
# Ignores the entire C++ compilation directory generated by Verilator
sim_build*/

# 2. Hardware Waveforms
# Traces can become massive (gigabytes for real chips). Never commit them.
*.vcd
*.fst

# 3. Test Results
# The JUnit XML generated by Cocotb/Pytest
results.xml

# 4. Python Virtual Environments
.venv/
venv/
env/
*.egg-info/

# 5. Python Cache
__pycache__/
*.py[cod]
